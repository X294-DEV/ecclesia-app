generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PASTOR
  SECRETARIO
  TESORERO
  COORDINADOR
}

enum EventType {
  RELIGIOSO
  ADMINISTRATIVO
}

enum EventStatus {
  ACTIVO
  CANCELADO
}

enum PaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  OTRO
}

// RF-10: una sola fila (id = 1)
model Church {
  id        Int               @id @default(1)
  name      String
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  schedules MeetingSchedule[]
  updatedAt DateTime          @updatedAt
}

model MeetingSchedule {
  id          String  @id @default(cuid())
  churchId    Int     @default(1)
  church      Church  @relation(fields: [churchId], references: [id])
  dayOfWeek   Int // 0 = domingo ... 6 = sábado
  time        String // "HH:mm"
  description String
}

// RF-01
model User {
  id            String               @id @default(cuid())
  name          String
  email         String               @unique
  passwordHash  String
  role          Role
  active        Boolean              @default(true)
  memberId      String?              @unique
  member        Member?              @relation(fields: [memberId], references: [id])
  resetTokens   PasswordResetToken[]
  donations     Donation[]
  announcements Announcement[]
  createdAt     DateTime             @default(now())
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
}

// RF-02: baja lógica con "active", nunca delete
model Member {
  id           String           @id @default(cuid())
  name         String
  phone        String?
  email        String?
  joinDate     DateTime
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  user         User?
  ministries   MinistryMember[]
  coordinates  Ministry[]       @relation("MinistryCoordinator")
  responsible  Event[]          @relation("EventResponsible")
  attendances  Attendance[]
  donations    Donation[]

  @@index([name])
}

// RF-05
model Ministry {
  id            String           @id @default(cuid())
  name          String           @unique
  description   String?
  coordinatorId String?
  coordinator   Member?          @relation("MinistryCoordinator", fields: [coordinatorId], references: [id])
  members       MinistryMember[]
  events        Event[]
}

model MinistryMember {
  id         String   @id @default(cuid())
  ministryId String
  ministry   Ministry @relation(fields: [ministryId], references: [id], onDelete: Cascade)
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id])

  @@unique([ministryId, memberId])
}

// RF-04
model Event {
  id            String       @id @default(cuid())
  title         String
  date          DateTime
  time          String // "HH:mm"
  location      String
  description   String?
  type          EventType
  status        EventStatus  @default(ACTIVO)
  responsibleId String?
  responsible   Member?      @relation("EventResponsible", fields: [responsibleId], references: [id])
  ministryId    String?
  ministry      Ministry?    @relation(fields: [ministryId], references: [id])
  attendances   Attendance[]

  @@index([date])
}

// RF-03
model Attendance {
  id       String  @id @default(cuid())
  eventId  String
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memberId String
  member   Member  @relation(fields: [memberId], references: [id])
  present  Boolean

  @@unique([eventId, memberId])
}

// RF-06: memberId nulo = aportación anónima
model Donation {
  id          String        @id @default(cuid())
  date        DateTime
  amount      Decimal       @db.Decimal(12, 2)
  concept     String
  method      PaymentMethod
  memberId    String?
  member      Member?       @relation(fields: [memberId], references: [id])
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([date])
}

// RF-07
model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  important   Boolean  @default(false)
  publishedAt DateTime @default(now())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
}
